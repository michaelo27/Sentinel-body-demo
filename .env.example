# Sentinel Body — copy to .env (gitignored). NEVER commit real keys.
# ---------------------------------------------------------------------------
# Networks
SETTLED_NETWORK=testnet
DATA_NETWORK=mainnet            # flip to "testnet" if hackathon rules require all-testnet data
NFT_CONTRACT_ID=sentinel-body.testnet   # overwritten by deployments/testnet.json after deploy
GATEWAY_URL=http://localhost:8787

# Access tiers
PUBLIC_DELAY_MINUTES=15         # demo value; production default is 360
JWT_SECRET=change-this-to-a-random-32-byte-hex
JWT_TTL_SECONDS=600
HOLDER_CACHE_SECONDS=30

# Runtime
ROUND_INTERVAL_MINUTES=30
DEMO_REPLAY=0                   # 1 = replay previously recorded REAL snapshots, badged "Replay"
PORT=8787
RUNTIME_VERSION=0.1.0

# Agent signing keys (local keystore, never committed)
KEYSTORE_DIR=./keys
GENESIS_AGENT_ACCOUNT=agent-0.sentinel-body.testnet
# GENESIS_WORKER_PRIVATE_KEY=ed25519:<base58 64 bytes>   # set by scripts/deploy.mjs

# NFT / mint
MINT_SEED_NEAR=0.35
DEFAULT_WORKER_ALLOWANCE_NEAR=0.25
MIN_PUBLISH_INTERVAL_SECONDS=20

# Optional: override RPC fallback order (comma separated); config/rpc.json is the default
# RPC_TESTNET_OVERRIDE=https://test.rpc.fastnear.com,https://near-testnet.drpc.org
# RPC_MAINNET_OVERRIDE=https://free.rpc.fastnear.com
